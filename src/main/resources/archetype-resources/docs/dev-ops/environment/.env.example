#set( $dollar = '$' )
#set( $hash = '#' )
${hash} Copy to .env. Replace ALL CHANGE_ME values with distinct 24-128 character secrets.
${hash} Password alphabet: A-Z a-z 0-9 _ -. Example generator: python -c "import secrets; print(secrets.token_hex(32))"
MYSQL_PORT=3306
MYSQL_PASSWORD=CHANGE_ME_APP_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_DATABASE_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
NACOS_DB_PASSWORD=CHANGE_ME_NACOS_DATABASE_PASSWORD
${hash} NACOS_AUTH_TOKEN must be standard Base64 encoding at least 32 random bytes.
${hash} python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(48)).decode())"
NACOS_AUTH_TOKEN=CHANGE_ME_BASE64_TOKEN
NACOS_AUTH_IDENTITY_VALUE=CHANGE_ME_NACOS_IDENTITY_VALUE
XXL_JOB_DB_PASSWORD=CHANGE_ME_XXL_DATABASE_PASSWORD
XXL_JOB_ACCESS_TOKEN=CHANGE_ME_XXL_ACCESS_TOKEN
XXL_JOB_ADMIN_PASSWORD=CHANGE_ME_XXL_ADMIN_PASSWORD
BROKER_ADVERTISE_HOST=127.0.0.1
