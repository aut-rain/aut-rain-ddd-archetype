#set( $dollar = '$' )
#set( $hash = '#' )
<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.autrain</groupId>
    <artifactId>${artifactId}</artifactId>
    <version>${version}</version>
    <packaging>pom</packaging>
    <name>${projectName} backend</name>
    <description>Generated Java + React application</description>
    <modules>
        <module>${artifactId}-types</module>
        <module>${artifactId}-api</module>
        <module>${artifactId}-domain</module>
        <module>${artifactId}-infrastructure</module>
        <module>${artifactId}-trigger</module>
        <module>${artifactId}-app</module>
    </modules>
    <properties>
        <java.version>21</java.version>
        <aut-rain-bom.version>1.1.0</aut-rain-bom.version>
        <!-- BOM imports do not manage build plugins. Keep this aligned with the BOM Spring Boot baseline. -->
        <spring-boot-maven-plugin.version>3.5.11</spring-boot-maven-plugin.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.aut-rain</groupId>
                <artifactId>aut-rain-bom</artifactId>
                <version>${dollar}{aut-rain-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.autrain</groupId>
                <artifactId>${artifactId}-types</artifactId>
                <version>${version}</version>
            </dependency>
            <dependency>
                <groupId>com.autrain</groupId>
                <artifactId>${artifactId}-api</artifactId>
                <version>${version}</version>
            </dependency>
            <dependency>
                <groupId>com.autrain</groupId>
                <artifactId>${artifactId}-domain</artifactId>
                <version>${version}</version>
            </dependency>
            <dependency>
                <groupId>com.autrain</groupId>
                <artifactId>${artifactId}-infrastructure</artifactId>
                <version>${version}</version>
            </dependency>
            <dependency>
                <groupId>com.autrain</groupId>
                <artifactId>${artifactId}-trigger</artifactId>
                <version>${version}</version>
            </dependency>
            <dependency>
                <groupId>com.autrain</groupId>
                <artifactId>${artifactId}-app</artifactId>
                <version>${version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>${dollar}{java.version}</release>
                        <parameters>true</parameters>
                        <encoding>${dollar}{project.build.sourceEncoding}</encoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${dollar}{spring-boot-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
