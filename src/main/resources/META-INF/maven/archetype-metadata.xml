<?xml version="1.0" encoding="UTF-8"?>
<archetype-descriptor name="aut-rain-ddd">
  <requiredProperties>
    <requiredProperty key="artifactId"><validationRegex>[a-z][a-z0-9-]{1,39}</validationRegex></requiredProperty>
    <requiredProperty key="groupId"><defaultValue>com.autrain</defaultValue></requiredProperty>
    <!-- IDEA forwards defaults literally. Source packages are derived from artifactId inside templates. -->
    <requiredProperty key="package"><defaultValue>com.rain</defaultValue></requiredProperty>
    <requiredProperty key="projectName"><defaultValue>${artifactId}</defaultValue><validationRegex>[A-Za-z0-9][A-Za-z0-9 _-]{0,79}</validationRegex></requiredProperty>
    <requiredProperty key="databaseName"><defaultValue>app_db</defaultValue><validationRegex>[a-z][a-z0-9_]{0,47}</validationRegex></requiredProperty>
    <requiredProperty key="httpPort"><defaultValue>80</defaultValue><validationRegex>([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])</validationRegex></requiredProperty>
  </requiredProperties>
  <fileSets>
    <fileSet filtered="true" packaged="false"><directory>app-backend</directory><includes><include>**/*</include></includes></fileSet>
    <fileSet filtered="true" packaged="false"><directory>web</directory><includes><include>**/*</include></includes></fileSet>
    <fileSet filtered="true" packaged="false"><directory>docs</directory><includes><include>**/*</include></includes></fileSet>
    <fileSet filtered="true" packaged="false"><directory></directory><includes>
      <include>.editorconfig</include><include>.env.example</include><include>.gitattributes</include><include>gitignore.template</include><include>README.md</include>
    </includes></fileSet>
  </fileSets>
</archetype-descriptor>
